    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\backend\src\RepairRequest.Infrastructure\RepairRequest.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\..\backend\src\RepairRequest.Application\RepairRequest.Application.csproj" />
    <ProjectReference Include="..\..\..\..\backend\src\RepairRequest.Domain\RepairRequest.Domain.csproj" />
  </ItemGroup>

</Project>
