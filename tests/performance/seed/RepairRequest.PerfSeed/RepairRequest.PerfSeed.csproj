<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Performance seed tooling for the Work Order timeline evidence (docs/15 §13). NOT part of RepairRequest.slnx, never built
    or run by CI, never an application code path and never an EF migration. It only talks to a dedicated LocalDB database.
  -->
